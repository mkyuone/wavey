{
  "name": "Wavey Audio Navigator",
  "short_name": "Wavey",
  "description": "Review local audio faster with a clear waveform and quick jumps between audible sections and quiet gaps.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3D59F5",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./pwa.webmanifest",
      "id": "./"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "accept": {
        "audio/aac": [".aac"],
        "audio/flac": [".flac"],
        "audio/mp4": [".m4a"],
        "audio/mpeg": [".mp3"],
        "audio/ogg": [".oga", ".ogg", ".opus"],
        "audio/wav": [".wav"],
        "audio/webm": [".weba"],
        "audio/x-wav": [".wav"],
        "video/mp4": [".m4v", ".mp4"],
        "video/quicktime": [".mov"],
        "video/webm": [".webm"],
        "video/x-matroska": [".mkv"],
        "video/x-msvideo": [".avi"]
      }
    }
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
